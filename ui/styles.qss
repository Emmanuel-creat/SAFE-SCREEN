/* ScreenGuard — QSS global pour les widgets Qt résiduels
   (mini-fenêtre, overlay, dialogue de calibration, popup de décision).
   La fenêtre principale est rendue en HTML/CSS/JS dans ui_web/. */

QWidget {
    background-color: #1d2025;
    color: #e4e7eb;
    font-family: "Segoe UI Variable Text", "Segoe UI Variable", "Segoe UI", sans-serif;
    font-size: 13px;
}
QLabel {
    background: transparent;
    padding: 0px;
}
QPushButton {
    background-color: #22262c;
    color: #e4e7eb;
    border: 1px solid #2a2e35;
    border-radius: 12px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 600;
}
QPushButton:hover {
    background-color: #262a30;
    border-color: #4ade80;
}
QPushButton:pressed {
    background-color: #1a1d22;
}
QPushButton:disabled {
    color: #6c737e;
    border-color: #22262c;
}
QSlider::groove:horizontal {
    height: 6px;
    background: #15171b;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #4ade80;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}
QSlider::sub-page:horizontal {
    background: #22c55e;
    border-radius: 3px;
}
QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #22262c;
    border: 1px solid #2a2e35;
    border-radius: 10px;
    padding: 7px 12px;
    color: #e4e7eb;
    font-size: 13px;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: #1a1d22;
    border: none;
    width: 20px;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #22262c;
    border: 1px solid #2a2e35;
    selection-background-color: #22c55e;
    color: #e4e7eb;
}
QCheckBox {
    spacing: 8px;
    color: #e4e7eb;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid #2a2e35;
    background: #22262c;
}
QCheckBox::indicator:checked {
    background: #4ade80;
    border-color: #4ade80;
}
QGroupBox {
    background-color: #22262c;
    border: 1px solid #131518;
    border-radius: 14px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
    font-weight: 600;
    font-size: 13px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 12px;
    color: #a3a9b3;
}
QScrollArea {
    border: none;
    background: transparent;
}
QProgressBar {
    background: #15171b;
    border: 1px solid #22262c;
    border-radius: 6px;
    height: 14px;
    text-align: center;
    color: #e4e7eb;
    font-size: 10px;
}
QProgressBar::chunk {
    background: #4ade80;
    border-radius: 5px;
}
