QWidget {
    background-color: #0a0e17;
    color: #e8ecf4;
    font-family: "Segoe UI", "SF Pro Display", "Helvetica Neue", sans-serif;
    font-size: 13px;
}
QLabel {
    background: transparent;
    padding: 0px;
}
QPushButton {
    background-color: #1a2235;
    color: #e8ecf4;
    border: 1px solid #2d3a50;
    border-radius: 8px;
    padding: 10px 20px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #151d2e;
    border-color: #00b37d;
}
QPushButton:pressed {
    background-color: #111827;
}
QPushButton:disabled {
    color: #4a5568;
    border-color: #1e293b;
}
QSlider::groove:horizontal {
    height: 6px;
    background: #1a2235;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #00e5a0;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}
QSlider::sub-page:horizontal {
    background: #00b37d;
    border-radius: 3px;
}
QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #1a2235;
    border: 1px solid #2d3a50;
    border-radius: 6px;
    padding: 6px 12px;
    color: #e8ecf4;
    font-size: 13px;
}
QSpinBox::up-button, QSpinBox::down-button,
QDoubleSpinBox::up-button, QDoubleSpinBox::down-button {
    background: #151d2e;
    border: none;
    width: 20px;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #111827;
    border: 1px solid #2d3a50;
    selection-background-color: #00b37d;
    color: #e8ecf4;
}
QCheckBox {
    spacing: 8px;
    color: #e8ecf4;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 2px solid #2d3a50;
    background: #1a2235;
}
QCheckBox::indicator:checked {
    background: #00e5a0;
    border-color: #00e5a0;
}
QGroupBox {
    background-color: #151d2e;
    border: 1px solid #1e293b;
    border-radius: 10px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
    font-weight: 600;
    font-size: 13px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 12px;
    color: #8892a4;
}
QScrollArea {
    border: none;
    background: transparent;
}
QProgressBar {
    background: #1a2235;
    border: 1px solid #2d3a50;
    border-radius: 6px;
    height: 14px;
    text-align: center;
    color: #e8ecf4;
    font-size: 10px;
}
QProgressBar::chunk {
    background: #00e5a0;
    border-radius: 5px;
}
